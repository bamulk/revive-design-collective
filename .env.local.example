# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs — used in emails, share links, and Plaid redirects.
NEXT_PUBLIC_APP_URL=https://app.revivedesigncollective.com
NEXT_PUBLIC_SITE_URL=https://app.revivedesigncollective.com

# Resend (https://resend.com) — transactional email
RESEND_API_KEY=
# e.g. "Revive Design Collective <invoices@revivedesigncollective.com>"
EMAIL_FROM=
# Optional inbox CC'd on extension confirmations
COMPANY_CC_EMAIL=
# Optional Reply-To for all app email (falls back to EMAIL_FROM)
EMAIL_REPLY_TO=

# Web push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@revivedesigncollective.com

# SignatureAPI (https://signatureapi.com) — e-signatures for contracts
SIGNATURE_API_KEY=key_test_...
# Optional shared secret for the /api/signatures/webhook endpoint.
# Set the same value in the SignatureAPI dashboard webhook config.
SIGNATURE_WEBHOOK_SECRET=

# Google Maps — for address autocomplete on the Stage form.
# Create at https://console.cloud.google.com (enable Maps JavaScript API +
# Places API, add http://localhost:3000 and your prod domain to the HTTP
# referrer restrictions). Safe to expose since it's HTTP-referrer-locked.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side geocoding (can reuse the same Google Cloud project)
GOOGLE_GEOCODING_API_KEY=

# Plaid (https://dashboard.plaid.com) — bank feed for the Finance area
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# RapidAPI — property details lookup (Zillow data)
RAPIDAPI_KEY=

# Protects the /api/cron/* endpoints (set the same value in Vercel cron config)
CRON_SECRET=

# Optional: home-base (warehouse) coordinates used for travel-fee distance calculations
WAREHOUSE_LAT=
WAREHOUSE_LNG=
